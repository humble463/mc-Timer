<!-- ==================== 一键复制指令 ==================== -->
<local:MyCard Title="一键复制指令" Margin="0,0,0,15">
    <StackPanel Margin="25,40,23,15">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <local:MyButton Margin="0,0,10,0" Width="160" Height="35" Padding="13,0,13,0"
                            Text="灵魂出窍" EventType="复制文本" EventData="/gamemode spectator"
                            ToolTip="复制：切换到旁观模式（灵魂出窍）" />
            <local:MyButton Margin="0,0,10,0" Width="160" Height="35" Padding="13,0,13,0"
                            Text="死亡不掉落" EventType="复制文本" EventData="/gamerule keepInventory true"
                            ToolTip="复制：开启死亡不掉落" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <local:MyButton Margin="0,0,10,0" Width="160" Height="35" Padding="13,0,13,0"
                            Text="关闭友伤" EventType="复制文本" EventData="/team modify [队伍名] friendlyFire false"
                            ToolTip="复制：关闭队伍友伤（需先用 /team add 创建队伍）" />
            <local:MyButton Margin="0,0,10,0" Width="160" Height="35" Padding="13,0,13,0"
                            Text="回到出生点" EventType="复制文本" EventData="/spawn"
                            ToolTip="复制：传送到出生点" />
        </StackPanel>
    </StackPanel>
</local:MyCard>

