<!-- ==================== 欢迎横幅 ==================== -->
<local:MyCard Title="主页" Margin="0,0,0,15">
    <StackPanel Margin="25,40,23,15">
        <TextBlock FontSize="26" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}"
                   Text="欢迎回来！" />
        <TextBlock FontSize="14" Foreground="{DynamicResource ColorBrush2}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="这里是属于你的 Minecraft 小窝，点击下方板块开始探索吧。" />
    </StackPanel>
</local:MyCard>

